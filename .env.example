# ---------------------------------------------------------------------------
# Model access -- pick ONE of the three routes below.
#
# The agent auto-detects in this order, or set LLM_PROVIDER to force one:
#   gateway   -> LangSmith LLM Gateway. No provider key needed; authenticates
#                with LANGSMITH_API_KEY. The only option if your organisation
#                does not issue provider keys. Model IDs are provider-qualified.
#   anthropic -> Anthropic directly, with ANTHROPIC_API_KEY.
#   openai    -> OpenAI directly, with OPENAI_API_KEY.
# ---------------------------------------------------------------------------

# --- Route 1: LLM Gateway (no provider key) ---
# LLM_GATEWAY_BASE_URL="https://gateway.smith.langchain.com/v1"
# LLM_MODEL="anthropic/claude-haiku-4-5-20251001"

# --- Route 2: Anthropic directly ---
# ANTHROPIC_API_KEY=""
# LLM_MODEL="claude-haiku-4-5-20251001"

# --- Route 3: OpenAI directly (the original default) ---
OPENAI_API_KEY=""
# LLM_MODEL="gpt-4o-mini"

# Force a route instead of auto-detecting: gateway | anthropic | openai
# LLM_PROVIDER=""

# ---------------------------------------------------------------------------
# LangSmith tracing and evaluation
#
# Cloud (SaaS):  https://api.smith.langchain.com
#                (regional: https://eu.api.smith.langchain.com,
#                 https://apac.api.smith.langchain.com,
#                 https://aws.api.smith.langchain.com)
# Self-hosted:   https://<your-langsmith-host>/api
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="text2sql-agent-local"

# ---------------------------------------------------------------------------
# LangSmith Deployment control plane (only needed to deploy from CI)
#
# `saas` deploys straight from this GitHub repository; `self-hosted` deploys a
# Docker image you build and push yourself. The control plane only accepts one
# source per hosting model, so this choice decides the whole deployment path.
# ---------------------------------------------------------------------------
LANGSMITH_DEPLOYMENT_TARGET="saas"

# The workspace to deploy into. Find it under Settings → Workspaces in LangSmith.
LANGSMITH_WORKSPACE_ID=""

# --- SaaS only ---
# Cloud data region: us | eu | apac | aws-us
LANGSMITH_REGION="us"
# GitHub App installation that grants the control plane access to this repo.
# Retrieve it from GET /v1/integrations/github/install.
LANGSMITH_GITHUB_INTEGRATION_ID=""

# --- Self-hosted only ---
# The control plane lives at /api-host on your LangSmith instance.
# CONTROL_PLANE_HOST="https://langsmith.your-company.com/api-host"
# Optional: pin deployments to a specific listener (GET /v2/listeners).
# LANGSMITH_LISTENER_ID=""
